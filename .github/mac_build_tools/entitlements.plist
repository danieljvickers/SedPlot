<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
   "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow execution outside the sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow file system access -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow temporary access to Downloads/Desktop/Documents (optional) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <key>com.apple.security.files.documents.read-write</key>
    <true/>
    <key>com.apple.security.files.desktop.read-write</key>
    <true/>

    <!-- Allow printing if needed -->
    <key>com.apple.security.print</key>
    <true/>
</dict>
</plist>